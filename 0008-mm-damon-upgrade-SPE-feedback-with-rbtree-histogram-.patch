+			unsigned int spp = chunk_sz >> PAGE_SHIFT;
 
-		sub_folio = folio_walk_start(&fw, vma, chunk_addr, 0);
-		if (!sub_folio) {
-			bitmap_zero(hot_bitmap, num_chunks);
-			return -EOPNOTSUPP;
+			for (j = 0; j < spp; j++) {
