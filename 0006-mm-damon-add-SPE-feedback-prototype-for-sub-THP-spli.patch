diff --git a/mm/damon/spe.c b/mm/damon/spe.c
new file mode 100644
index 000000000000..71e47011d761
--- /dev/null
+++ b/mm/damon/spe.c
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * DAMON SPE (Statistical Profiling Extension) feedback — prototype
+ *
+ * Provides sub-THP access heatmap for intelligent split decisions.
+ *
+ * Prototype (this file):
+ *   Uses PTE access bits via folio_walk.  Works only when a THP has been
+ *   previously split to PTEs (by an earlier split_folio_to_order call).
+ *   Returns -EOPNOTSUPP for PMD-mapped THPs.
+ *
+ * Production (TODO — Kunpeng 920+):
+ *   1. Open a kernel-internal SPE perf event via perf_event_create_kernel_counter
+ *   2. On SPE buffer overflow IRQ, decode SPE records:
+ *      - Extract {virt_addr, phys_addr, access_type} from each record
+ *      - SPE packet format: ARM ARM DDI 0487, Chapter D9 "SPE"
+ *   3. Aggregate into a per-process rbtree: {pfn → access_count[] per subpage}
+ *   4. On damon_spe_folio_heatmap(), query the rbtree for the folio's pfn
+ *   5. Return a bitmap of accessed sub-pages at target_order granularity
+ *
+ * Copyright (C) 2026 Wang Lian <lianux.mm@gmail.com>
+ */
+
+#define pr_fmt(fmt) "damon-spe: " fmt
+
+#include <linux/mm.h>
+#include <linux/pagewalk.h>
+#include <linux/huge_mm.h>
+#include <linux/bitmap.h>
+#include "spe.h"
+
+/* Max sub-pages when splitting a PMD-order THP to base pages (order 0) */
+#define DAMON_SPE_MAX_CHUNKS	512
+
+int damon_spe_folio_heatmap(struct folio *folio, struct vm_area_struct *vma,
+			    unsigned long addr, unsigned int target_order,
+			    unsigned long *hot_bitmap)
+{
+	unsigned long num_chunks = folio_nr_pages(folio) >> target_order;
+	unsigned long chunk_sz = PAGE_SIZE << target_order;
+	unsigned long i;
+	struct folio_walk fw;
+	struct folio *sub_folio;
+
+	if (!folio || !vma || !hot_bitmap)
+		return -EINVAL;
+	if (target_order >= folio_order(folio))
+		return -EINVAL;
+
+	bitmap_zero(hot_bitmap, num_chunks);
+
+	for (i = 0; i < num_chunks; i++) {
+		unsigned long chunk_addr = addr + i * chunk_sz;
+
+		sub_folio = folio_walk_start(&fw, vma, chunk_addr, 0);
+		if (!sub_folio) {
+			bitmap_zero(hot_bitmap, num_chunks);
+			return -EOPNOTSUPP;
+		}
+
+		/*
+		 * PMD-mapped THP: folio_walk_start succeeds but all sub-page
+		 * addresses share the same PMD access bit.  Return -EOPNOTSUPP
+		 * so the caller falls back to unconditional split.
+		 */
+		if (fw.level == FW_LEVEL_PMD) {
+			folio_walk_end(&fw, vma);
+			bitmap_zero(hot_bitmap, num_chunks);
+			return -EOPNOTSUPP;
+		}
+
+		if (fw.level == FW_LEVEL_PTE && pte_young(fw.pte))
+			__set_bit(i, hot_bitmap);
+
+		folio_walk_end(&fw, vma);
+	}
+
+	return (int)num_chunks;
+}
+EXPORT_SYMBOL_GPL(damon_spe_folio_heatmap);
+
+int damon_spe_hot_fraction(struct folio *folio, struct vm_area_struct *vma,
+			   unsigned long addr, unsigned int target_order)
+{
+	unsigned long num_chunks = folio_nr_pages(folio) >> target_order;
+	DECLARE_BITMAP(hot_bitmap, DAMON_SPE_MAX_CHUNKS);
+	int ret, hot;
+
+	if (num_chunks > DAMON_SPE_MAX_CHUNKS)
+		return -ERANGE;
+
+	ret = damon_spe_folio_heatmap(folio, vma, addr, target_order,
+				      hot_bitmap);
+	if (ret < 0)
+		return ret;
+
+	hot = bitmap_weight(hot_bitmap, num_chunks);
+	return (hot * 100) / (int)num_chunks;
+}
+EXPORT_SYMBOL_GPL(damon_spe_hot_fraction);
diff --git a/mm/damon/spe.h b/mm/damon/spe.h
new file mode 100644
index 000000000000..4922f991d734
--- /dev/null
+++ b/mm/damon/spe.h
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * DAMON SPE (Statistical Profiling Extension) feedback
+ *
+ * Provides sub-THP access heatmap for intelligent split decisions.
+ * Prototype: uses PTE access bits on non-SPE hardware.
+ * Production: integrates ARM SPE PMU on supported platforms (e.g. Kunpeng 920).
+ *
+ * Copyright (C) 2026 Wang Lian <lianux.mm@gmail.com>
+ */
+
+#ifndef _DAMON_SPE_H
+#define _DAMON_SPE_H
+
+#include <linux/mm_types.h>
+
+#ifdef CONFIG_DAMON_SPE
+
+/*
+ * damon_spe_folio_heatmap - Get sub-THP access bitmap for a folio
+ * @folio: The folio to query (must be locked or ref'd by caller)
+ * @vma:   VMA containing the folio (for page table walk)
+ * @addr:  Virtual address of the folio
+ * @target_order: Granularity of the bitmap (each bit = one chunk of this order)
+ * @hot_bitmap:   Output bitmap, bit N=1 means Nth chunk was accessed
+ *
+ * Returns: number of bits in the bitmap on success,
+ *          -EOPNOTSUPP if SPE data is not available (caller should fall back
+ *          to unconditional split).
+ *
+ * On hardware with ARM SPE, reads the PMU buffer to determine which sub-pages
+ * within a THP have been accessed.  The bitmap is relative to @target_order:
+ * e.g. for a PMD-order THP (order=9) with target_order=2:
+ *   - The THP has 2^(9-2) = 128 chunks of order-2
+ *   - hot_bitmap has 128 bits, max return value 128
+ *
+ * On hardware without SPE, splits the PMD to PTEs and checks access bits,
+ * but only if the PMD is already split.  Returns -EOPNOTSUPP otherwise.
+ */
+int damon_spe_folio_heatmap(struct folio *folio, struct vm_area_struct *vma,
+			    unsigned long addr, unsigned int target_order,
+			    unsigned long *hot_bitmap);
+
+/*
+ * damon_spe_hot_fraction - Fraction of chunks that were accessed
+ *
+ * Convenience wrapper: returns the fraction (0..100) of hot chunks.
+ * Returns -EOPNOTSUPP if data unavailable.
+ */
+int damon_spe_hot_fraction(struct folio *folio, struct vm_area_struct *vma,
+			   unsigned long addr, unsigned int target_order);
+
+#else /* !CONFIG_DAMON_SPE */
+
+static inline int damon_spe_folio_heatmap(struct folio *folio,
+		struct vm_area_struct *vma, unsigned long addr,
+		unsigned int target_order, unsigned long *hot_bitmap)
+{
+	return -EOPNOTSUPP;
+}
+
+static inline int damon_spe_hot_fraction(struct folio *folio,
+		struct vm_area_struct *vma, unsigned long addr,
+		unsigned int target_order)
+{
+	return -EOPNOTSUPP;
+}
+
+#endif /* CONFIG_DAMON_SPE */
+#endif /* _DAMON_SPE_H */
diff --git a/mm/damon/vaddr.c b/mm/damon/vaddr.c
index 6e337fc60703..8df827007093 100644
--- a/mm/damon/vaddr.c
+++ b/mm/damon/vaddr.c
@@ -18,6 +18,7 @@
 
 #include "../internal.h"
 #include "ops-common.h"
+#include "spe.h"
 
 #ifdef CONFIG_DAMON_VADDR_KUNIT_TEST
 #undef DAMON_MIN_REGION_SZ
@@ -947,6 +948,7 @@ static unsigned long damos_va_mthp_split(struct damon_target *target,
 	struct vm_area_struct *vma;
 	struct folio *folio;
 	struct folio_walk fw;
+	int hot_pct;
 
 	mm = damon_get_mm(target);
 	if (!mm)
@@ -974,8 +976,18 @@ static unsigned long damos_va_mthp_split(struct damon_target *target,
 			folio_get(folio);
 			folio_walk_end(&fw, vma);
 
-			if (!split_folio_to_order(folio, target_order))
-				applied += chunk_sz;
+			/*
+			 * Query sub-THP access hotness.  On SPE-capable
+			 * hardware this reads PMU samples; the prototype
+			 * checks PTE access bits.  Returns -EOPNOTSUPP
+			 * when data is unavailable (split unconditionally).
+			 */
+			hot_pct = damon_spe_hot_fraction(folio, vma, addr,
+							 target_order);
+			if (hot_pct < 80) {
+				if (!split_folio_to_order(folio, target_order))
+					applied += chunk_sz;
+			}
 
 			folio_unlock(folio);
 			folio_put(folio);
